# Database
DB_HOST=your-postgres-host
DB_PORT=5432
DB_NAME=your_database
DB_USER=your_db_user
DB_PASSWORD=your_db_password

# JWT — generate with: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET=change-me-to-a-random-secret

# SFTP
SFTP_HOST=your-sftp-host
SFTP_PORT=22
SFTP_USER=sftp_service_account
SFTP_PASSWORD=sftp_password
SFTP_DATA_DIR=/data
SFTP_LOGS_DIR=/logs
SFTP_OUTPUT_DIR=/output

# CORS — comma-separated list of allowed origins
CORS_ORIGINS=http://localhost,http://localhost:80

# Docker Compose only (docker-compose.yml) — all optional, default to the
# values above (host port 8000/80, matching CORS_ORIGINS). Only set these
# if those host ports are already in use by something else locally; if you
# change FRONTEND_PORT, update CORS_ORIGINS above to match, and if you
# change BACKEND_PORT, update API_BASE_URL to match too.
# BACKEND_PORT=8011
# FRONTEND_PORT=8081
# API_BASE_URL=http://localhost:8011
